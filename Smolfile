image = "./oeis.tar"
cpus = 8
memory = 8192
storage = 100
overlay = 100
net = true
net_backend = "virtio-net"
gpu = false
workdir = "/workspace"
cmd = ["sleep", "infinity"]
env = [
  "PI_OFFLINE=true",
  "PI_CODING_AGENT_DIR=/workspace/system/.pi/agent"
  "LAB_BASE_URL=http://10.77.0.1:8080/v1",
  "LAB_GPU_HOST=10.77.0.1",
  "LAB_GPU_USER=labgpu-oeis-learn",
  "LAB_GPU_IDENTITY=/home/agent/.ssh/lab-gpu",
]

[dev]
user = "agent"

[network]
allow_cidrs = ["10.77.0.1/32"]
allow_hosts = [
  "index.docker.io",
  "auth.docker.io",
  "registry-1.docker.io",
  "production.cloudfront.docker.com",
  "pypi.org",
  "files.pythonhosted.org",
  "deb.debian.org",
  "sh.rustup.rs",
  "static.rust-lang.org",
  "github.com",
  "static.crates.io",
  "registry.npmjs.org",
]
