[network]
allow_cidrs = ["10.77.0.1/32"]
allow_hosts = [
  "index.docker.io",
  "auth.docker.io",
  "registry-1.docker.io",
  "production.cloudfront.docker.com",
  "pypi.org",
  "files.pythonhosted.org",
]
