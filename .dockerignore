# VCS
.git
.gitignore
*.swp

# Python environments & caches
.venv
.venv-speckit
venv
.mypy_cache
.pytest_cache
.benchmarks
__pycache__
*.py[cod]
*.so
*.egg-info/
*.egg

# Build artifacts
target
crates/**/target
dist
build
wheels

# Large / generated artifacts
*.tar
*.pt
*.pth
*.ckpt
*.bin
oeis.tar
checkpoints
runs
research
reports
.specify/*
!.specify/memory
.specify/memory/*
!.specify/memory/constitution.md
.pi

# Local phase review diagnostics
pytest-of-root
phase9-*.xml
phase9-*.log
debug_stream.py
.uv-cache
phase9-evidence

# Disposable review work
tmp*/
.review-venv
.role-venv
.venv-*
phase11-evidence
phase10-*.log
phase10-*.xml
phase10-evidence

# CI outputs and local tooling caches must not invalidate COPY layers.
.ruff_cache
uv-cache/
wheel-evidence/
phase7-evidence/
phase13-evidence/
phase7-*.xml
phase7-environment.txt
phase7-*-environment.txt
*.whl

# Persistent local application artifacts
run-state/
container-cache/

# Local credentials and obsolete untracked development files are never image inputs.
system/
**/.ssh/
.env
.env.*

# Local pytest temporary trees under any execution account
pytest-of-*/

# Full corpus and retained caches are mounted explicitly, never image inputs.
data/*
!data/benchmarks/
data/benchmarks/*
# Only these tracked qualification fixtures belong in the image.
!data/benchmarks/symbolic_definitions_v1.json
!data/benchmarks/trustworthy_synthesis_v1.json
downloads/
**/*.duckdb
