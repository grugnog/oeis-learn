{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Request": {
      "type": "object",
      "properties": {
        "protocol": {
          "enum": [
            "synthesis-worker/v1"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+(?![\\s\\S])"
        },
        "operation": {
          "enum": [
            "fit",
            "execute",
            "replay_unsat"
          ]
        },
        "worker_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "language_profile": {
          "enum": [
            "bigint-body/v1"
          ]
        },
        "resource_profile": {
          "enum": [
            "bigint-resources/v1"
          ]
        },
        "solver_profile": {
          "enum": [
            "native-fitting/v1"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_.-]+(?![\\s\\S])"
              },
              "original_source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "original_source_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "codec_profile": {
                "enum": [
                  "bigint-codec/v1"
                ]
              },
              "parameter_ids": {
                "type": "array",
                "items": {
                  "enum": [
                    "p0",
                    "p1",
                    "p2",
                    "p3",
                    "p4",
                    "p5",
                    "p6",
                    "p7"
                  ]
                },
                "maxItems": 8,
                "minItems": 0,
                "uniqueItems": true
              },
              "abstraction_policy": {
                "enum": [
                  "none",
                  "eligible-literals/v1"
                ]
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "source_sha256": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "prompt_sha256": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "resource_sha256": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "constraints_sha256": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "coefficient_bits": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "abstraction_policy": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "solver": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "language_profile": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "required": [
                  "version",
                  "source_sha256",
                  "prompt_sha256",
                  "resource_sha256",
                  "constraints_sha256",
                  "coefficient_bits",
                  "abstraction_policy",
                  "solver",
                  "language_profile"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "candidate_id",
              "original_source",
              "original_source_sha256",
              "codec_profile",
              "parameter_ids",
              "abstraction_policy"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "minItems": 1
        },
        "visible_indices": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])",
            "maxLength": 1235
          },
          "maxItems": 20,
          "minItems": 1
        },
        "visible_values": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])",
            "maxLength": 1235
          },
          "maxItems": 20,
          "minItems": 1
        },
        "remaining_budget": {
          "type": "object",
          "properties": {
            "wall_time_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          },
          "required": [
            "wall_time_ms",
            "attempts"
          ],
          "additionalProperties": false
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "protocol",
        "request_id",
        "operation",
        "worker_generation",
        "contract_sha256",
        "language_profile",
        "resource_profile",
        "solver_profile",
        "candidates",
        "visible_indices",
        "visible_values",
        "remaining_budget",
        "seed"
      ],
      "additionalProperties": false
    },
