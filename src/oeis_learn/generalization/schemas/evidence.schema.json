{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oeis-learn.invalid/generalization/evidence.schema.json",
  "$comment": "Phase A shape contract only. Identity bytes, provenance, isolation, execution and admission require Phase B verification.",
  "type": "object",
  "properties": {
    "version": {
      "const": "generalization-evidence/v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "study": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "effective_invocation": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "qualification_producers": {
      "type": "array",
      "items": {
        "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "stage_ledger": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "identities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$",
        "minLength": 71,
        "maxLength": 71
      },
      "minItems": 1,
      "maxItems": 1000000
    },
    "coverage": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "attempts": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "families": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "seeds": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "summary": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "selection": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "exposure": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "costs": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "bounds": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "interpretation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$",
            "not": {
              "pattern": "\\s"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "minLength": 71,
            "maxLength": 71
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "software_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "PARTIAL",
        "INCONCLUSIVE",
        "INTERRUPTED"
      ]
    },
    "scientific_status": {
      "enum": [
        "UNMEASURED",
        "POSITIVE",
        "NEGATIVE",
        "INCONCLUSIVE"
      ]
    }
  },
  "required": [
    "version",
    "identity",
    "study",
    "effective_invocation",
    "qualification_producers",
    "stage_ledger",
    "identities",
    "coverage",
    "attempts",
    "families",
    "seeds",
    "summary",
    "selection",
    "exposure",
    "costs",
    "bounds",
    "interpretation",
    "inventory",
    "omissions",
    "software_status",
    "scientific_status"
  ],
  "additionalProperties": false
}
