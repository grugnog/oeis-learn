{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oeis-learn.invalid/generalization/pac.schema.json",
  "$comment": "Closed phase A records. Policy validation and installed authority are separate gates; private records must never be generically exported.",
  "oneOf": [
    {
      "$ref": "#/$defs/experiment"
    },
    {
      "$ref": "#/$defs/control"
    },
    {
      "$ref": "#/$defs/inventory"
    },
    {
      "$ref": "#/$defs/target_pair"
    },
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/review"
    },
    {
      "$ref": "#/$defs/adaptive"
    },
    {
      "$ref": "#/$defs/transaction"
    },
    {
      "$ref": "#/$defs/checkpoint"
    },
    {
      "$ref": "#/$defs/progress"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/envelope"
    }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "output_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target_stratum": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "length_stratum": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "id",
        "family",
        "offset",
        "source_hash",
        "output_hash",
        "target_stratum",
        "length_stratum"
      ],
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "probes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 8,
          "maxItems": 8
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 4,
          "maxItems": 4
        },
        "missing_strata": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 32768
        }
      },
      "required": [
        "id",
        "rows",
        "probes",
        "anchors",
        "missing_strata"
      ],
      "additionalProperties": false
    },
    "loss": {
      "type": "object",
      "properties": {
        "panel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "probe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 2,
          "maxItems": 2
        },
        "model_update": {
          "type": "integer",
          "minimum": 0
        },
        "loss_sum": {
          "type": "number"
        },
        "tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "panel_id",
        "probe_ids",
        "model_update",
        "loss_sum",
        "tokens"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "acquired": {
          "type": "boolean"
        },
        "queue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "last_exposure": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "due_update": {
          "type": "integer",
          "minimum": 0
        },
        "last_grade": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_event": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "family",
        "acquired",
        "queue",
        "last_exposure",
        "due_update",
        "last_grade",
        "last_event"
      ],
      "additionalProperties": false
    },
    "row_stream": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "row_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "permutation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "rng": {
          "type": "array",
          "prefixItems": [
            {
              "const": 3
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "minItems": 625,
              "maxItems": 625
            },
            {
              "type": "null"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "family",
        "row_ids",
        "permutation",
        "epoch",
        "cursor",
        "rng"
      ],
      "additionalProperties": false
    },
    "pending_update": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "row_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model_before": {
          "type": "integer",
          "minimum": 0
        },
        "grade": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "anchor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "success": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "anchor",
                "success"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "channel": {
          "enum": [
            "bandit",
            "review",
            "fallback"
          ]
        }
      },
      "required": [
        "event_id",
        "row_ids",
        "tokens",
        "model_before",
        "grade",
        "channel"
      ],
      "additionalProperties": false
    },
    "pending_block": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "probability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "probe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pre": {
          "anyOf": [
            {
              "$ref": "#/$defs/loss"
            },
            {
              "type": "null"
            }
          ]
        },
        "post": {
          "anyOf": [
            {
              "$ref": "#/$defs/loss"
            },
            {
              "type": "null"
            }
          ]
        },
        "planned_updates": {
          "type": "integer",
          "minimum": 0
        },
        "completed_updates": {
          "type": "integer",
          "minimum": 0
        },
        "charged_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "pre",
            "updates",
            "post",
            "feedback",
            "terminal"
          ]
        },
        "pending_update": {
          "anyOf": [
            {
              "$ref": "#/$defs/pending_update"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "family",
        "probability",
        "probe_ids",
        "pre",
        "post",
        "planned_updates",
        "completed_updates",
        "charged_tokens",
        "phase",
        "pending_update"
      ],
      "additionalProperties": false
    },
    "budget_node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "mode": {
          "enum": [
            "serial",
            "parallel"
          ]
        },
        "overhead_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cleanup_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "seconds",
        "children",
        "mode",
        "overhead_seconds",
        "cleanup_seconds"
      ],
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "properties": {
        "version": {
          "const": "PAC-screen/v1"
        },
        "identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "arms": {
          "type": "array",
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "minItems": 2,
          "maxItems": 4
        },
        "comparison_factors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "initializer": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "initializer_kind": {
          "enum": [
            "random"
          ]
        },
        "pool": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "probes": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "targets": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inventory": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy": {
          "const": "pac-exp3s-leitner/v1"
        },
        "budget_graph": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/budget_node"
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "control": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "control_mode": {
          "enum": [
            "matched",
            "reference-only",
            "fresh-control"
          ]
        },
        "frozen": {
          "type": "boolean"
        },
        "outcomes_seen": {
          "type": "boolean"
        },
        "target_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "optimizer": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "backend": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "order": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "exposure": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "diagnostics": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "literal_targets": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution": {
          "$ref": "#/$defs/identity"
        }
      },
      "required": [
        "version",
        "identity",
        "arms",
        "comparison_factors",
        "seed",
        "initializer",
        "initializer_kind",
        "pool",
        "probes",
        "targets",
        "inventory",
        "policy",
        "budget_graph",
        "metrics",
        "control",
        "control_mode",
        "frozen",
        "outcomes_seen",
        "target_tokens",
        "model",
        "optimizer",
        "backend",
        "order",
        "source",
        "exposure",
        "diagnostics",
        "literal_targets",
        "execution"
      ],
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "version": {
          "const": "pac-control/v1"
        },
        "identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "original_study": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "image": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checkpoint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "initializer": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checks": {
          "type": "object",
          "properties": {
            "initializer": {
              "type": "boolean"
            },
            "order": {
              "type": "boolean"
            },
            "model": {
              "type": "boolean"
            },
            "optimizer": {
              "type": "boolean"
            },
            "exposure": {
              "type": "boolean"
            },
            "diagnostics": {
              "type": "boolean"
            },
            "backend": {
              "type": "boolean"
            }
          },
          "required": [
            "initializer",
            "order",
            "model",
            "optimizer",
            "exposure",
            "diagnostics",
            "backend"
          ],
          "additionalProperties": false
        },
        "disposition": {
          "enum": [
            "MATCHED",
            "REFERENCE_ONLY"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "initializer",
              "order",
              "model",
              "optimizer",
              "exposure",
              "diagnostics",
              "backend"
            ]
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "historical_measurements": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected": {
          "type": "object",
          "properties": {
            "initializer": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "order": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "model": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "optimizer": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "exposure": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "diagnostics": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "backend": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "initializer",
            "order",
            "model",
            "optimizer",
            "exposure",
            "diagnostics",
            "backend"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "identity",
        "original_study",
        "source",
        "image",
        "checkpoint",
        "initializer",
        "checks",
        "disposition",
        "reasons",
        "historical_measurements",
        "expected"
      ],
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "version": {
          "const": "pac-inventory/v1"
        },
        "identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "const": "training"
        },
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/family"
          },
          "minItems": 32,
          "maxItems": 32
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          },
          "minItems": 32768,
          "maxItems": 32768
        },
        "sidecar": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "probe_seed": {
          "type": "integer",
          "minimum": 0
        },
        "probe_draws": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "draws": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "family",
              "draws"
            ],
            "additionalProperties": false
          },
          "minItems": 32,
          "maxItems": 32
        },
        "source_dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "reason",
              "count"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "exclusion_dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "reason",
              "count"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "shared_training_windows": {
          "type": "integer",
          "minimum": 0
        },
        "exclusions": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "identity",
        "role",
        "families",
        "rows",
        "sidecar",
        "probe_seed",
        "probe_draws",
        "source_dispositions",
        "exclusion_dispositions",
        "shared_training_windows",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "target_pair": {
      "type": "object",
      "properties": {
        "version": {
          "const": "pac-target-pair/v1"
        },
        "identity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "const": "training"
        },
        "concrete_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "literal_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "parameter_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "literal_tokens": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "maxItems": 32768
        },
        "parameter_tokens": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 0,
              "maxItems": 32768
            },
            {
              "type": "null"
            }
          ]
        },
