{
  "type": "object",
  "properties": {
    "version": {
      "const": "discovery-exposure/v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "purpose": {
      "enum": [
        "acceptance",
        "research"
      ]
    },
    "track": {
      "enum": [
        "synthetic_strict",
        "oeis_derived",
        "external_assisted"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "previous": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "detector_limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "relations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "minItems": 0,
                "maxItems": 4096,
                "uniqueItems": true
              },
              "role": {
                "enum": [
                  "training",
                  "development",
                  "confirmation",
                  "assessment"
                ]
              },
              "endpoint": {
                "enum": [
                  "parameter",
                  "composition",
                  "unseen_structure",
                  "oeis",
                  "retention",
                  "reward"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "access": {
                "enum": [
                  "membership",
                  "truth",
                  "outcome"
                ]
              },
              "campaign": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "group",
              "relations",
              "role",
              "endpoint",
              "source",
              "access",
              "campaign"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100000
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "progressive-common.schema.json#/$defs/artifact"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "previous",
        "detector_limits",
        "events"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "identity",
    "created_at",
    "parents",
    "purpose",
    "track",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-exposure.schema.json"
}
