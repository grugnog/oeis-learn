{
  "type": "object",
  "properties": {
    "version": {
      "const": "discovery-task/v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "purpose": {
      "enum": [
        "acceptance",
        "research"
      ]
    },
    "track": {
      "enum": [
        "synthetic_strict",
        "oeis_derived",
        "external_assisted"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "campaign": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"
        },
        "stage": {
          "enum": [
            "capability",
            "diversity",
            "tuning",
            "scaling",
            "oeis",
            "components",
            "source_pilot"
          ]
        },
        "kind": {
          "enum": [
            "training",
            "preparation",
            "evaluation",
            "qualification",
            "packaging"
          ]
        },
        "arm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "initializer": {
          "$ref": "progressive-common.schema.json#/$defs/initializer"
        },
        "token_target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "caps": {
          "$ref": "progressive-common.schema.json#/$defs/caps"
        },
        "startup_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "finalization_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "policy": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "slot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
        }
      },
      "required": [
        "campaign",
        "id",
        "stage",
        "kind",
        "arm",
        "seed",
        "initializer",
        "token_target",
        "caps",
        "startup_us",
        "finalization_us",
        "policy",
        "slot",
        "output"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "identity",
    "created_at",
    "parents",
    "purpose",
    "track",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-task.schema.json"
}
