{
  "type": "object",
  "properties": {
    "version": {
      "const": "discovery-task/v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "purpose": {
      "enum": [
        "acceptance",
        "research"
      ]
    },
    "track": {
      "enum": [
        "synthetic_strict",
        "oeis_derived",
        "external_assisted"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "campaign": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"
        },
        "stage": {
          "enum": [
            "capability",
            "diversity",
            "tuning",
            "scaling",
            "oeis",
            "components",
            "source_pilot"
          ]
        },
        "kind": {
          "enum": [
            "training",
            "preparation",
            "evaluation",
            "qualification",
            "packaging"
          ]
        },
        "arm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "initializer": {
          "$ref": "progressive-common.schema.json#/$defs/initializer"
        },
        "token_target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "caps": {
          "$ref": "progressive-common.schema.json#/$defs/caps"
        },
        "startup_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "finalization_us": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "policy": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "slot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
        },
        "iteration_budget": {
          "type": "object",
          "properties": {
            "update_us": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000000
            },
            "probe_us": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000000
            },
            "checkpoint_us": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000000
            },
            "producer": {
              "$ref": "progressive-common.schema.json#/$defs/artifact"
            }
          },
          "required": [
            "update_us",
            "probe_us",
            "checkpoint_us",
            "producer"
          ],
          "additionalProperties": false
        },
        "trial_runtime": {
          "$ref": "progressive-common.schema.json#/$defs/artifact"
        },
        "trial_choices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "lr_multiplier": {
                    "enum": [
                      0.3,
                      1,
                      3
                    ]
                  },
                  "schedule": {
                    "enum": [
                      "constant",
                      "warmup_cosine"
                    ]
                  },
                  "effective_batch": {
                    "enum": [
                      16,
                      32,
                      64
                    ]
                  },
                  "weight_decay": {
                    "enum": [
                      0,
                      0.01,
                      0.1
                    ]
                  },
                  "dropout": {
                    "enum": [
                      0,
                      0.1,
                      0.2
                    ]
                  },
                  "shape": {
                    "enum": [
                      "reference",
                      "smaller_width",
                      "shallower",
                      "larger"
                    ]
                  }
                },
                "required": [
                  "lr_multiplier",
                  "schedule",
                  "effective_batch",
                  "weight_decay",
                  "dropout"
                ],
                "additionalProperties": false
              },
              "compatibility": {
                "$ref": "progressive-common.schema.json#/$defs/hash"
              },
              "policy": {
                "$ref": "progressive-common.schema.json#/$defs/hash"
              },
              "runtime": {
                "$ref": "progressive-common.schema.json#/$defs/artifact"
              },
              "iteration_budget": {
                "type": "object",
                "properties": {
                  "update_us": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000000
                  },
                  "probe_us": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000000
                  },
                  "checkpoint_us": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000000
                  },
                  "producer": {
                    "$ref": "progressive-common.schema.json#/$defs/artifact"
                  }
                },
                "required": [
                  "update_us",
                  "probe_us",
                  "checkpoint_us",
                  "producer"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "parameters",
              "compatibility",
              "policy"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 648
        },
        "trial": {
          "type": "object",
          "properties": {
            "study": {
              "$ref": "progressive-common.schema.json#/$defs/hash"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "phase": {
              "enum": [
                "proposal",
                "training",
                "generation",
                "scoring",
                "confirmation",
                "selection",
                "retention"
              ]
            },
            "coordinate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4000000
            },
            "shared_finalization_us": {
              "type": "integer",
              "minimum": 1800000000,
              "maximum": 7200000000
            }
          },
          "required": [
            "study",
            "ordinal",
            "phase",
            "coordinate"
          ],
          "additionalProperties": false
        },
        "trial_choice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 647
        }
      },
      "required": [
        "campaign",
        "id",
        "stage",
        "kind",
        "arm",
        "seed",
        "initializer",
        "token_target",
        "caps",
        "startup_us",
        "finalization_us",
        "policy",
        "slot",
        "output"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "identity",
    "created_at",
    "parents",
    "purpose",
    "track",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-task.schema.json"
}
