{
  "type": "object",
  "properties": {
    "version": {
      "const": "discovery-archive/v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "purpose": {
      "enum": [
        "acceptance",
        "research"
      ]
    },
    "track": {
      "enum": [
        "synthetic_strict",
        "oeis_derived",
        "external_assisted"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "progressive-common.schema.json#/$defs/artifact"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "previous": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "progressive-common.schema.json#/$defs/hash"
            }
          ]
        },
        "sampling": {
          "const": "task-first-then-alternative"
        },
        "eviction": {
          "const": "stable-task-id"
        },
        "maximum_alternatives": {
          "const": 2
        }
      },
      "required": [
        "capacity",
        "seed",
        "entries",
        "previous",
        "sampling",
        "eviction",
        "maximum_alternatives"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "identity",
    "created_at",
    "parents",
    "purpose",
    "track",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-stream.schema.json"
}
