{
  "type": "object",
  "properties": {
    "version": {
      "const": "discovery-library/v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "purpose": {
      "enum": [
        "acceptance",
        "research"
      ]
    },
    "track": {
      "enum": [
        "synthetic_strict",
        "oeis_derived",
        "external_assisted"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "bigint-pure-components/v1"
        },
        "components": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "arguments": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "type": {
                      "enum": [
                        "bigint",
                        "bool",
                        "control"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "returns": {
                "enum": [
                  "bigint",
                  "bool",
                  "control"
                ]
              },
              "body": {
                "$ref": "#/$defs/ast"
              },
              "expanded_ast": {
                "$ref": "#/$defs/ast"
              },
              "dependencies": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              },
              "origins": {
                "type": "array",
                "minItems": 3,
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "properties": {
                    "artifact": {
                      "$ref": "progressive-common.schema.json#/$defs/artifact"
                    },
                    "role": {
                      "const": "training"
                    },
                    "group": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "structure": {
                      "$ref": "progressive-common.schema.json#/$defs/hash"
                    },
                    "source": {
                      "$ref": "progressive-common.schema.json#/$defs/hash"
                    },
                    "path": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16
                      }
                    },
                    "bindings": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "$ref": "#/$defs/ast"
                      }
                    }
                  },
                  "required": [
                    "artifact",
                    "role",
                    "group",
                    "structure",
                    "source",
                    "path",
                    "bindings"
                  ],
                  "additionalProperties": false
                }
              },
              "assumptions": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            },
            "required": [
              "id",
              "arguments",
              "returns",
              "body",
              "expanded_ast",
              "dependencies",
              "origins",
              "assumptions"
            ],
            "additionalProperties": false
          }
        },
        "bounds": {
          "type": "object",
          "properties": {
            "maximum_components": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "dependency_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "maximum_arguments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "expanded_nodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "expanded_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            }
          },
          "required": [
            "maximum_components",
            "dependency_depth",
            "maximum_arguments",
            "expanded_nodes",
            "expanded_bytes"
          ],
          "additionalProperties": false
        },
        "previous": {
          "oneOf": [
            {
              "$ref": "progressive-common.schema.json#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "DIAGNOSTIC_ONLY",
                "NATIVE_VERIFIED"
              ]
            },
            "native": {
              "oneOf": [
                {
                  "$ref": "progressive-common.schema.json#/$defs/hash"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reference": {
              "$ref": "progressive-common.schema.json#/$defs/hash"
            },
            "parser": {
              "$ref": "progressive-common.schema.json#/$defs/hash"
            },
            "proofs": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "progressive-common.schema.json#/$defs/artifact"
              }
            }
          },
          "required": [
            "status",
            "native",
            "reference",
            "parser",
            "proofs"
          ],
          "additionalProperties": false
        },
        "semantics": {
          "const": "hygienic_operand_order_expansion"
        },
        "scientific_status": {
          "const": "UNMEASURED"
        }
      },
      "required": [
        "profile",
        "components",
        "bounds",
        "previous",
        "verification",
        "semantics",
        "scientific_status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "identity",
    "created_at",
    "parents",
    "purpose",
    "track",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-library.schema.json",
  "$defs": {
    "ast": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/ast"
          }
        }
      ]
    }
  }
}
