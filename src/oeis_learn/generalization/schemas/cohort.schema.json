{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oeis-learn.invalid/generalization/cohort.schema.json",
  "$comment": "Phase A shape contract only. Identity bytes, provenance, isolation, execution and admission require Phase B verification.",
  "type": "object",
  "properties": {
    "version": {
      "const": "generalization-cohort/v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "role": {
      "enum": [
        "training",
        "selection",
        "assessment",
        "historical"
      ]
    },
    "family_rule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$",
        "minLength": 71,
        "maxLength": 71
      },
      "minItems": 1,
      "maxItems": 1000000
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$",
        "minLength": 71,
        "maxLength": 71
      },
      "minItems": 1,
      "maxItems": 1000000
    },
    "quotas": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "coverage": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "exclusions": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    },
    "indices": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(0|-?[1-9][0-9]*)$",
        "not": {
          "pattern": "\\s"
        },
        "maxLength": 4934
      },
      "minItems": 100,
      "maxItems": 100
    },
    "public_payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$",
            "not": {
              "pattern": "\\s"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "minLength": 71,
            "maxLength": 71
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "private_payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$",
            "not": {
              "pattern": "\\s"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "minLength": 71,
            "maxLength": 71
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000000
    },
    "preparation_ledger": {
      "$ref": "https://oeis-learn.invalid/generalization/common.schema.json#/$defs/artifact"
    }
  },
  "required": [
    "version",
    "identity",
    "role",
    "family_rule",
    "sources",
    "variants",
    "groups",
    "quotas",
    "coverage",
    "exclusions",
    "indices",
    "public_payloads",
    "private_payloads",
    "preparation_ledger"
  ],
  "additionalProperties": false
}
