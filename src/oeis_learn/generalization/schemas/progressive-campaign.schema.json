{
  "type": "object",
  "properties": {
    "version": {
      "const": "discovery-campaign/v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "purpose": {
      "enum": [
        "acceptance",
        "research"
      ]
    },
    "track": {
      "enum": [
        "synthetic_strict",
        "oeis_derived",
        "external_assisted"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "blueprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "graph": {
          "$ref": "progressive-common.schema.json#/$defs/graph"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"
              },
              "stage": {
                "enum": [
                  "capability",
                  "diversity",
                  "tuning",
                  "scaling",
                  "oeis",
                  "components",
                  "source_pilot"
                ]
              },
              "kind": {
                "enum": [
                  "training",
                  "preparation",
                  "evaluation",
                  "qualification",
                  "packaging"
                ]
              },
              "arm": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "initializer": {
                "$ref": "progressive-common.schema.json#/$defs/initializer"
              },
              "token_target": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "caps": {
                "$ref": "progressive-common.schema.json#/$defs/caps"
              },
              "startup_us": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "finalization_us": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "policy": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "slot": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"
              },
              "output": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
              },
              "iteration_budget": {
                "type": "object",
                "properties": {
                  "update_us": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000000
                  },
                  "probe_us": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000000
                  },
                  "checkpoint_us": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400000000
                  },
                  "producer": {
                    "$ref": "progressive-common.schema.json#/$defs/artifact"
                  }
                },
                "required": [
                  "update_us",
                  "probe_us",
                  "checkpoint_us",
                  "producer"
                ],
                "additionalProperties": false
              },
              "trial_runtime": {
                "$ref": "progressive-common.schema.json#/$defs/artifact"
              }
            },
            "required": [
              "id",
              "stage",
              "kind",
              "arm",
              "seed",
              "initializer",
              "token_target",
              "caps",
              "startup_us",
              "finalization_us",
              "policy",
              "slot",
              "output"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 256
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "progressive-common.schema.json#/$defs/reference"
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "caps": {
          "$ref": "progressive-common.schema.json#/$defs/caps"
        },
        "storage": {
          "type": "object",
          "properties": {
            "checkpoint_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "atomic_generations": {
              "const": 2
            },
            "milestone_pins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "shard_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "package_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "required_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "available_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "required_inodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "available_inodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "task_store_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "projection_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "journal_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "checkpoint_inodes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "checkpoint_bytes",
            "atomic_generations",
            "milestone_pins",
            "shard_bytes",
            "package_bytes",
            "required_bytes",
            "available_bytes",
            "required_inodes",
            "available_inodes"
          ],
          "additionalProperties": false
        },
        "target_policy": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "blueprint",
        "runtime",
        "graph",
        "tasks",
        "references",
        "caps",
        "storage",
        "target_policy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "identity",
    "created_at",
    "parents",
    "purpose",
    "track",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-campaign.schema.json"
}
