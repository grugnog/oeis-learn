{
  "type": "object",
  "properties": {
    "version": {
      "const": "discovery-trial/v1"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "purpose": {
      "enum": [
        "acceptance",
        "research"
      ]
    },
    "track": {
      "enum": [
        "synthetic_strict",
        "oeis_derived",
        "external_assisted"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "proposal": {
          "type": "object",
          "properties": {
            "study": {
              "$ref": "progressive-common.schema.json#/$defs/hash"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "parameters": {
              "type": "object",
              "properties": {
                "lr_multiplier": {
                  "enum": [
                    0.3,
                    1,
                    3
                  ]
                },
                "schedule": {
                  "enum": [
                    "constant",
                    "warmup_cosine"
                  ]
                },
                "effective_batch": {
                  "enum": [
                    16,
                    32,
                    64
                  ]
                },
                "weight_decay": {
                  "enum": [
                    0,
                    0.01,
                    0.1
                  ]
                },
                "dropout": {
                  "enum": [
                    0,
                    0.1,
                    0.2
                  ]
                },
                "shape": {
                  "enum": [
                    "reference",
                    "smaller_width",
                    "shallower",
                    "larger"
                  ]
                }
              },
              "required": [
                "lr_multiplier"
              ],
              "additionalProperties": false
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "identity": {
              "$ref": "progressive-common.schema.json#/$defs/hash"
            }
          },
          "required": [
            "study",
            "ordinal",
            "parameters",
            "seed",
            "identity"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "PROPOSED",
            "RESERVED",
            "RUNNING",
            "COMPLETE",
            "PRUNED",
            "FAILED",
            "PARTIAL",
            "INFEASIBLE"
          ]
        },
        "recovery_pending": {
          "type": "boolean"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "elapsed_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "invocation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "COMPLETE",
                    "PRUNED",
                    "FAILED",
                    "PARTIAL",
                    "INFEASIBLE"
                  ]
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "elapsed_us": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ]
                },
                "role": {
                  "const": "development"
                },
                "evidence": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "progressive-trial-evidence.schema.json#/$defs/evidence"
                    }
                  ]
                }
              },
              "required": [
                "status",
                "tokens",
                "elapsed_us",
                "value",
                "role"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "proposal",
        "status",
        "recovery_pending",
        "tokens",
        "elapsed_us",
        "invocation",
        "result"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "identity",
    "created_at",
    "parents",
    "purpose",
    "track",
    "payload"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "progressive-trial.schema.json"
}
