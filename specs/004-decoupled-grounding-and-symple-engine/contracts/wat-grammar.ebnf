# WebAssembly Text (WAT) EBNF Grammar for oeis-learn Phase 4
# Decoupled Symbolic-Numeric WAT Grammar with Placeholder Terminal Support

wat_module        ::= "(" "module" func_def+ ")"

func_def          ::= "(" "func" identifier? export_decl signature local_decl* instruction+ ")"

export_decl       ::= "(" "export" "\"compute\"" ")"

signature         ::= mandatory_param result_decl

mandatory_param   ::= "(" "param" "$n" "i32" ")"

result_decl       ::= "(" "result" "i64" ")"

local_decl        ::= "(" "local" identifier valtype ")"

valtype           ::= "i32" | "i64"

instruction       ::= plain_instr | folded_instr

plain_instr       ::= var_instr
                    | const_instr
                    | arith_instr
                    | control_instr

# Environment-Indexed Variable Access (Includes mandatory $n parameter binding)
var_instr         ::= "local.get" ws valid_var_index
                    | "local.set" ws valid_var_index
                    | "local.tee" ws valid_var_index

# Constant instructions: Concrete Integer Immediate OR Generic Solver Placeholder
const_instr       ::= "i32.const" ws integer_literal
                    | "i64.const" ws integer_literal
                    | "i64.const_?"

# Stack-Type Governed Arithmetic
arith_instr       ::= "i64.add"
                    | "i64.sub"
                    | "i64.mul"
                    | "i64.div_s"
                    | "i64.div_u"
                    | "i64.rem_s"
                    | "i64.rem_u"
                    | "i64.and"
                    | "i64.or"
                    | "i64.xor"
                    | "i64.shl"
                    | "i64.shr_s"
                    | "i64.shr_u"
                    | "i64.eqz"
                    | "i64.eq"
                    | "i64.ne"
                    | "i64.lt_s"
                    | "i64.gt_s"
                    | "i64.le_s"
                    | "i64.ge_s"
                    | "i32.wrap_i64"
                    | "i64.extend_i32_s"
                    | "i64.extend_i32_u"

# Control instructions
control_instr     ::= "nop"
                    | "drop"
                    | "unreachable"
                    | "return"
                    | "br" ws valid_label_index
                    | "br_if" ws valid_label_index

folded_instr      ::= "(" plain_instr instruction* ")"
                    | "(" "block" identifier? result_decl? instruction* ")"
                    | "(" "loop" identifier? result_decl? instruction* ")"
                    | "(" "if" identifier? result_decl? "(" "then" instruction* ")" ("(" "else" instruction* ")")? ")"

valid_var_index   ::= "$n" | "$a" | "$b" | "$c" | "$d" | "$i" | "$temp" | integer_literal

valid_label_index ::= "0" | "1" | "$l" | "$loop" | "$exit"

identifier        ::= "$" [a-zA-Z0-9_]+

integer_literal   ::= "-"? [0-9]+

string_literal    ::= "\"" [^\"]* "\""

ws                ::= [ \t\n\r]+
