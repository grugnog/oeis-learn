    {"id": "two_pow_64", "source": "i64.const 0 </int> i64.const 1 </int> i64.const 0 </int> i64.const 0 </int> i256.const", "expect": "0", "description": "Positive zero is 0, not i64 max (0x7FFF...)"},
    {"id": "cross_limb_carry", "source": "i64.const 1 </int> i64.const 0 </int> i64.const 0 </int> i64.const 0 </int> i256.zero", "expect": "1", "description": "Final result counts all four limbs, carry does not produce a phantom fifth limb"}
